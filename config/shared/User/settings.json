{
  "workbench.colorTheme": "Dark Minimalist",
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.pinEditor",
    "workbench.action.nextEditor",
    "workbench.action.previousEditor"
  ],
  "editor.minimap.enabled": false,
  // Open markdown in the built-in text editor, not the Office Viewer
  // custom editor (cweijan.vscode-office), whose webview steals focus
  // and disrupts other panes. "default" overrides the extension's
  // editor claim for *.md only; office docs (.docx/.xlsx/.pdf) still
  // use the viewer.
  "workbench.editorAssociations": {
    "*.md": "default"
  },
  "kilo-code.allowedCommands": [
    "git log",
    "git diff",
    "git show",
    "mkdir",
    "mv",
    "cd",
    "poetry run",
    "ls",
    "head",
    "PYTHONPATH=src",
    "PYTHONPATH=src poetry run",
    "chmod +x",
    "grep",
    "git status",
    "git add",
    "find",
    "sed",
    "wc",
    "git branch -a",
    "git branch",
    "echo",
    "cmake",
    "git fetch",
    "export",
    "poetry lock --check",
    "poetry show",
    "tail",
    "cuobjdump",
    "nm",
    "nvidia-smi",
    "timeout 30 poetry",
    "timeout 60 poetry",
    "touch",
    "timeout 120 poetry",
    "cut",
    "awk",
    "cp",
    "uniq",
    "sort",
    "cat",
    "tee",
    "xargs",
    "OVID_DEBUG_KEEP_TEMP=1",
    "nvlink",
    "ar",
    "make",
    "ptxas",
    "xxd",
    "file",
    "OVID_USE_LTOIR_WORKFLOW=true poetry run",
    "rg",
    "OVID_USE_LTOIR=1 poetry run",
    "timeout 5 poetry",
    "git merge-base",
    "date",
    "du",
    "NUMBA_DISABLE_JIT=1 poetry run",
    "rm -rf tmp/test-project-fixed",
    "mkdir -p tmp/test-project-fixed",
    "EOF",
    "rm -rf tmp/test-verification",
    "rsync",
    "{ echo",
    "tail -5",
    "{",
    "}",
    "tree",
    "pwd",
    "strings",
    "rm -rf build",
    "nvcc",
    "poetry poe clean",
    "rm -rf /tmp/ovid_binaries",
    "poetry poe rebuild",
    "CUDA_LAUNCH_BLOCKING=1 poetry run",
    "sleep 5",
    "PGPASSWORD= pg_dump",
    "PGHOST=localhost PGPORT=3307 PGDATABASE=crane_live_5",
    "ln",
    "hexdump",
    "stat",
    "readlink",
    "aws lambda invoke",
    "true",
    "test",
    "ulimit",
    "PGDATABASE=testpg",
    "DATABASE_URL=postgresql://crane_test:crane_test_password@localhost:5433/crane_test poetry",
    "clang-format",
    "ps",
    "crontab -l 2 > /dev/null",
    "npm install",
    "node",
    "curl -v \"http://127.0.0.1:8083/\" 2>&1",
    "head -20",
    "which",
    "systemd-analyze",
    "journalctl",
    "ss",
    "systemctl --user status code-server-proxy.service",
    "curl",
    "systemctl --user status code-server-workspace@workspace-32a592e8.service",
    "systemctl --user list-unit-files",
    "systemctl --user status code-server.service",
    "systemctl --user restart code-server-proxy.service",
    "systemctl --user restart code-server-workspace@main.service",
    "sleep",
    "free",
    "poetry poe build-c",
    "docker exec",
    "npx eslint",
    "npm run lint",
    "docker ps",
    "docker logs",
    "tail -20"
  ],
  "kilo-code.deniedCommands": [],
  "explorer.confirmDragAndDrop": false,
  "window.newWindowProfile": "Default",
  // Use pyright b/c problems w/ jedi and pylance unavailable in code-server
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.autoSearchPaths": true,
  "python.analysis.useLibraryCodeForTypes": true,
  // Ruff for linting/formatting
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "security.workspace.trust.untrustedFiles": "open",
  // Don't follow symlinks in search — prevents runaway rg from
  // circular symlinks in tmp/ directories across workspaces
  "search.followSymlinks": false,
  // File watcher exclusions - prevent watching huge directories
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.hg/store/**": true,
    "**/.cache/**": true,
    "**/backups/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/*.egg-info/**": true,
    "**/tmp/**": true
  },
  // Search exclusions - same directories
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.cache": true,
    "**/backups": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/build": true,
    "**/dist": true,
    "**/*.egg-info": true,
    "**/tmp": true
  },
  // Explorer exclusions. Hide tmp/ (planning/scratch) from the file tree
  // in every workspace. Besides decluttering, tmp/ often holds symlinks
  // pointing outside the repo; the built-in git extension runs
  // check-ignore to decorate visible files and throws "pathspec ... is
  // beyond a symbolic link" (exit 128) on any path traversing such a
  // symlink, which breaks the Explorer context menu for that workspace.
  // Hiding tmp/ stops the extension from ever traversing it. See bead 54a.
  "files.exclude": {
    "**/tmp": true
  },
  // Python-specific: Don't watch virtualenvs
  "python.analysis.exclude": [
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/tmp/**"
  ],
  "diffEditor.hideUnchangedRegions.enabled": true,
  // Disable shell integration to prevent exit-on-error bug
  "terminal.integrated.shellIntegration.enabled": false,
  // Disable Python terminal activation - host shell has its own environment setup
  "python.terminal.activateEnvironment": false,

  // Terminal profiles for SSH host and container shells
  // Kilo Code uses the default terminal profile for command execution
  "terminal.integrated.profiles.linux": {
    "Host Shell (SSH)": {
      "path": "/usr/local/bin/host-bash",
      "icon": "server"
    },
    "Container Shell": {
      "path": "bash",
      "args": ["--rcfile", "/etc/profile.d/container-env.sh"],
      "icon": "terminal-bash"
    }
  },
  "terminal.integrated.defaultProfile.linux": "Host Shell (tmux)",
  "terminal.integrated.enableMultiLinePasteWarning": "never"
}
