#!/bin/dash
# Forward shell commands to host via SSH (dash-compatible)
# Used by Kilo Code/VS Code extensions which run: /bin/sh -c "command"
#
# IMPORTANT: Only forwards commands from VS Code extension host processes.
# System scripts (s6 services, init scripts, etc.) run locally in container.
# Detection: VS Code sets VSCODE_CWD environment variable for extension processes.

# Skip if already on host (SSH session)
[ -n "$SSH_CONNECTION" ] && exec /bin/dash.real "$@"

# Skip if auto-SSH not enabled
[ "$ENABLE_AUTO_SSH" != "true" ] && exec /bin/dash.real "$@"

# Skip if HOST_USER not set
[ -z "$HOST_USER" ] && exec /bin/dash.real "$@"

# Skip if NOT running from VS Code extension host
# VS Code sets VSCODE_CWD for extension processes - only forward those
[ -z "$VSCODE_CWD" ] && exec /bin/dash.real "$@"

# Check if this is -c "command" style invocation
if [ "$1" = "-c" ] && [ -n "$2" ]; then
    # Commands that should run locally in container
    case "$2" in
        claude\ *|claude)
            # Let container's /usr/local/bin/claude wrapper handle SSH
            exec /bin/dash.real "$@"
            ;;
        git\ config\ *)
            # Don't forward git config - avoid modifying host gitconfig
            exec /bin/dash.real "$@"
            ;;
        */config/*|/config/*)
            # Commands referencing /config paths must run in container
            exec /bin/dash.real "$@"
            ;;
        ssh\ *host.docker.internal*)
            # Host-directed ssh (e.g. tmux-session-manager) must run
            # LOCALLY in the container — host.docker.internal only
            # resolves inside the container. Forwarding it to the host
            # would break name resolution. Defense-in-depth: the
            # extension now invokes ssh shell-free (execFile), which
            # already bypasses this wrapper; this arm covers any other
            # shell-string ssh-to-host caller.
            exec /bin/dash.real "$@"
            ;;
    esac

    # Forward command to host via login shell (for full PATH including ~/.local/bin)
    # Source .shrc for tool environments (CUDA, etc.) before executing command
    shrc_source=". ~/.shrc 2>/dev/null || true; "
    cd_prefix=""
    [ -n "$WORKSPACE_PATH" ] && cd_prefix="cd '$WORKSPACE_PATH' 2>/dev/null; "
    # Escape single quotes in command for bash -l -c '...'
    escaped_cmd=$(printf '%s' "$2" | sed "s/'/'\\\\''/g")

    # Try SSH with timeout. If it fails (connection error, not command error),
    # fall back to local execution to prevent code-server hangs.
    # Use -o ControlMaster=no to avoid stale control socket issues.
    ssh -o ConnectTimeout=5 -o ControlMaster=no -o BatchMode=yes \
        "$HOST_USER@host.docker.internal" \
        "bash -l -c '${shrc_source}${cd_prefix}${escaped_cmd}'"
    ssh_exit=$?

    # Exit codes 255 = SSH connection error, 127 = command not found on remote
    # For connection errors, fall back to local execution
    if [ $ssh_exit -eq 255 ]; then
        # SSH connection failed - run locally as fallback
        exec /bin/dash.real "$@"
    fi

    # For other exit codes (including 127 from remote), return as-is
    exit $ssh_exit
fi

# Otherwise run locally
exec /bin/dash.real "$@"
