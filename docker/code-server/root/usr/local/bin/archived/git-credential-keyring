#!/bin/bash
# Git credential helper using secret-tool
# DBUS_SESSION_BUS_ADDRESS and GNOME_KEYRING_CONTROL are set in Dockerfile
if [ "$1" = "get" ]; then
    while IFS='=' read -r key value; do
        case "$key" in
            protocol) protocol="$value" ;;
            host) host="$value" ;;
            username) username="$value" ;;
        esac
    done
    if [ -n "$protocol" ] && [ -n "$host" ]; then
        # Try with username if provided
        if [ -n "$username" ]; then
            password=$(secret-tool lookup protocol "$protocol" server "$host" user "$username" 2>/dev/null)
        fi
        # Try without username
        if [ -z "$password" ]; then
            password=$(secret-tool lookup protocol "$protocol" server "$host" 2>/dev/null)
        fi
        # If we found a password but no username was provided, try to get it from the secret
        if [ -n "$password" ] && [ -z "$username" ]; then
            username=$(secret-tool search protocol "$protocol" server "$host" 2>&1 | grep "attribute.user" | cut -d= -f2 | tr -d ' ')
        fi
        if [ -n "$password" ]; then
            echo "protocol=$protocol"
            echo "host=$host"
            [ -n "$username" ] && echo "username=$username"
            echo "password=$password"
        fi
    fi
fi
