#!/bin/bash
#
# patch-kilocode-opus45 - Add Claude Opus 4.5 to Kilo Code's Claude Code provider
#
# Kilo Code 4.122.1 added opus 4.5 for Anthropic/OpenRouter but not Claude Code provider.
# This script patches the extension to include it.
#
# Safe to run multiple times (idempotent).
# Run after Kilo Code updates if opus 4.5 disappears from model list.
#

set -e

EXT_DIR="/config/extensions"
KILO_DIR=$(ls -d "$EXT_DIR"/kilocode.kilo-code-* 2>/dev/null | head -1)

if [ -z "$KILO_DIR" ]; then
    echo "Error: Kilo Code extension not found in $EXT_DIR"
    exit 1
fi

echo "Found Kilo Code at: $KILO_DIR"

EXT_JS="$KILO_DIR/dist/extension.js"
WEBVIEW_JS="$KILO_DIR/webview-ui/build/assets/index.js"

# Check if already patched
if grep -q '"claude-opus-4-5-20251101":{\.\.\.Fp\["claude-opus-4-5-20251101"\]' "$EXT_JS" 2>/dev/null; then
    echo "extension.js already patched (d9 has opus 4.5)"
else
    # Check if base model exists (Fp has opus 4.5)
    if ! grep -q 'Fp\["claude-opus-4-5-20251101"\]' "$EXT_JS" 2>/dev/null; then
        echo "Warning: Base model Fp[\"claude-opus-4-5-20251101\"] not found in extension.js"
        echo "This Kilo Code version may not support opus 4.5 yet."
        exit 1
    fi

    echo "Patching extension.js (adding opus 4.5 to d9)..."
    sed -i 's/d9={"claude-sonnet-4-5"/d9={"claude-opus-4-5-20251101":{...Fp["claude-opus-4-5-20251101"],supportsImages:!1,supportsPromptCache:!0,supportsReasoningEffort:!1,supportsReasoningBudget:!0,requiredReasoningBudget:!1},"claude-sonnet-4-5"/g' "$EXT_JS"
    echo "  Done."
fi

# Check webview
if grep -q '\$E={"claude-opus-4-5-20251101"' "$WEBVIEW_JS" 2>/dev/null; then
    echo "webview index.js already patched (\$E has opus 4.5)"
else
    # Check if base model exists (us has opus 4.5)
    if ! grep -q 'us\["claude-opus-4-5-20251101"\]' "$WEBVIEW_JS" 2>/dev/null; then
        echo "Warning: Base model us[\"claude-opus-4-5-20251101\"] not found in webview"
        echo "This Kilo Code version may not support opus 4.5 yet."
        exit 1
    fi

    echo "Patching webview index.js (adding opus 4.5 to \$E)..."
    sed -i 's/\$E={"claude-sonnet-4-5"/\$E={"claude-opus-4-5-20251101":{...us["claude-opus-4-5-20251101"],supportsImages:!1,supportsPromptCache:!0,supportsReasoningEffort:!1,supportsReasoningBudget:!0,requiredReasoningBudget:!1},"claude-sonnet-4-5"/g' "$WEBVIEW_JS"
    echo "  Done."
fi

echo ""
echo "Patch complete. Restart the container to apply:"
echo "  restart-container"
