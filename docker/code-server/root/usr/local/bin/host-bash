#!/bin/bash
# Host bash wrapper - forwards shell commands to host via SSH
# Interactive terminals use tmux for persistence across disconnects.
# Each terminal pane gets its own tmux session (independent view).
# Non-interactive commands go direct (no tmux needed).
# SSH config is in /etc/ssh/ssh_config (ControlMaster, known_hosts, etc.)

if [ -z "$HOST_USER" ]; then
    exec /bin/bash "$@"
fi

SSH_DEST="$HOST_USER@host.docker.internal"
# INSTANCE_ID from env (container-manager), fallback to file (injected)
if [ -z "$INSTANCE_ID" ] && [ -f /run/instance-id ]; then
    INSTANCE_ID=$(cat /run/instance-id)
fi
IID="${INSTANCE_ID:-default}"
WORKDIR="${WORKSPACE_PATH:-.}"
shrc_source=". ~/.shrc 2>/dev/null || true; "

# --- Non-interactive: direct SSH, no tmux ---
if [ ! -t 0 ]; then
    cd_cmd=""
    [ -n "$WORKSPACE_PATH" ] && cd_cmd="cd '$WORKSPACE_PATH' && "
    exec ssh "$SSH_DEST" "${shrc_source}${cd_cmd}bash" "$@"
fi

# --- Interactive: tmux-backed terminal with reconnection loop ---

# Check SSH mux health before session creation
CONTROL_SOCKET="/run/user/1001/ssh-control-host.docker.internal"
if [ -S "$CONTROL_SOCKET" ]; then
    if ! timeout 3 ssh -o BatchMode=yes \
        "$SSH_DEST" true >/dev/null 2>&1; then
        rm -f "$CONTROL_SOCKET"
    fi
fi

# Determine tmux session to attach to.
# Priority: TMUX_SESSION (direct, from extension)
#         > TMUX_PANE_ID (mapped, from extension profile)
#         > grab first unattached session (reconnect on reload)
#         > create new session
if [ -n "$TMUX_SESSION" ]; then
    # Extension told us exactly which session — use it directly
    true
elif [ -n "$TMUX_PANE_ID" ]; then
    TMUX_SESSION=$(ssh -o ConnectTimeout=10 -o BatchMode=yes \
        "$SSH_DEST" \
        "${shrc_source}cs-tmux-window attach-or-create \
            '$IID' '$TMUX_PANE_ID' '$WORKDIR'")
else
    # Try to grab an unattached session for this instance.
    # On reload, code-server recreates terminals — each host-bash
    # grabs one unattached session instead of creating a new one.
    TMUX_SESSION=$(ssh -o ConnectTimeout=10 -o BatchMode=yes \
        "$SSH_DEST" \
        "${shrc_source}cs-tmux-window grab '$IID' '$WORKDIR'")
fi

if [ $? -ne 0 ] || [ -z "$TMUX_SESSION" ]; then
    echo "Failed to create tmux session" >&2
    exit 1
fi

# When VS Code closes the terminal pane, host-bash receives SIGHUP/SIGTERM.
# Kill the tmux session only if we're the last client attached.
# If another terminal is also viewing this session (duplicate), just detach.
cleanup_session() {
    attached=$(ssh -o ConnectTimeout=3 -o BatchMode=yes "$SSH_DEST" \
        "tmux display-message -t '$TMUX_SESSION' -p '#{session_attached}'" \
        2>/dev/null)
    if [ "${attached:-0}" -le 1 ]; then
        ssh -o ConnectTimeout=3 -o BatchMode=yes "$SSH_DEST" \
            "tmux kill-session -t '$TMUX_SESSION'" 2>/dev/null
    fi
    exit 0
}
trap cleanup_session HUP TERM

# Attach loop — reconnect to same session on SSH drop
MAX_RETRIES=60
RETRY_DELAY=2
retries=0

while true; do
    ssh -t \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=3 \
        "$SSH_DEST" \
        "tmux attach-session -t '$TMUX_SESSION'"
    exit_code=$?

    case $exit_code in
        0)
            # Clean exit: user typed 'exit' or session destroyed
            break
            ;;
        255)
            # SSH connection error — reconnect
            retries=$((retries + 1))
            if [ $retries -ge $MAX_RETRIES ]; then
                echo "SSH reconnection failed after $retries attempts" >&2
                exit 1
            fi
            echo "[reconnecting... attempt $retries]" >&2
            sleep $RETRY_DELAY
            ;;
        *)
            # tmux error — check if session still exists
            if ssh -o ConnectTimeout=5 -o BatchMode=yes \
                "$SSH_DEST" \
                "tmux has-session -t '$TMUX_SESSION'" \
                2>/dev/null; then
                retries=$((retries + 1))
                [ $retries -ge $MAX_RETRIES ] && break
                sleep $RETRY_DELAY
            else
                # Session gone — terminal is done
                break
            fi
            ;;
    esac
done
