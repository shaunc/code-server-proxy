#!/bin/bash
# Host bash wrapper - forwards shell commands to host via SSH
# Used as SHELL for Kilo Code to execute commands on host instead of container
# SSH config is in /etc/ssh/ssh_config (StrictHostKeyChecking, known_hosts, etc.)

if [ -z "$HOST_USER" ]; then
    # Fallback to container bash if HOST_USER not set
    exec /bin/bash "$@"
fi

# Build cd prefix if WORKSPACE_PATH is set
cd_cmd=""
if [ -n "$WORKSPACE_PATH" ]; then
    cd_cmd="cd '$WORKSPACE_PATH' && "
fi

# Source .shrc for tool environments (CUDA, etc.)
shrc_source=". ~/.shrc 2>/dev/null || true; "

# If stdin is a TTY, allocate PTY for SSH
if [ -t 0 ]; then
    exec ssh -t "$HOST_USER@host.docker.internal" "${shrc_source}${cd_cmd}exec bash" "$@"
fi

# Non-interactive: no PTY needed
exec ssh "$HOST_USER@host.docker.internal" "${shrc_source}${cd_cmd}bash" "$@"
