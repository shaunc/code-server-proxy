#!/bin/bash
# Host bash wrapper - forwards shell commands to host via SSH
# Interactive terminals use tmux for persistence across disconnects.
# Each terminal pane gets its own tmux session (independent view).
# Non-interactive commands go direct (no tmux needed).
# SSH config is in /etc/ssh/ssh_config (ControlMaster, known_hosts, etc.)

if [ -z "$HOST_USER" ]; then
    exec /bin/bash "$@"
fi

# VS Code / code-server resolves the shell environment by running
# `$SHELL -lic '<code-server node binary> ...'`. Both the pty host and the
# extension host mark that spawn with VSCODE_RESOLVING_ENVIRONMENT=1. Those
# binaries exist only inside THIS container, so forwarding the resolver to
# the host (below) makes the host shell exit 127 ("command not found"),
# which code-server retries on a ~30s cycle -> pty/ext-host churn -> the
# workbench blanks to background and redisplays (the "flicker") in every
# window. Resolve locally instead: the container already has the correct
# environment, and the resolver never needs the host.
if [ -n "$VSCODE_RESOLVING_ENVIRONMENT" ]; then
    exec /bin/bash "$@"
fi

SSH_DEST="$HOST_USER@host.docker.internal"
# INSTANCE_ID from env (container-manager), fallback to file (injected).
# Strip '-new' suffix left by pre-fix blue-green containers.
if [ -z "$INSTANCE_ID" ] && [ -f /run/instance-id ]; then
    INSTANCE_ID=$(cat /run/instance-id)
fi
IID="${INSTANCE_ID%-new}"
IID="${IID:-default}"
WORKDIR="${WORKSPACE_PATH:-.}"
shrc_source=". ~/.shrc 2>/dev/null || true; "

# --- Non-interactive: direct SSH, no tmux ---
# Skip tmux if: stdin is not a TTY, OR invoked with arguments
# (e.g., host-bash -c 'cmd', host-bash -ilc 'cmd' from VS Code's
# shell environment resolver). Only bare 'host-bash' with no args
# and a TTY should enter the tmux attach loop.
if [ ! -t 0 ] || [ $# -gt 0 ]; then
    cd_cmd=""
    [ -n "$WORKSPACE_PATH" ] && cd_cmd="cd '$WORKSPACE_PATH' && "
    exec ssh "$SSH_DEST" "${shrc_source}${cd_cmd}bash" "$@"
fi

# --- Interactive: tmux-backed terminal with reconnection loop ---

# Determine tmux session to attach to.
# Priority: TMUX_SESSION (direct, from extension)
#         > TMUX_PANE_ID (mapped, from extension profile)
#         > grab first unattached session (reconnect on reload)
#         > create new session
if [ -n "$TMUX_SESSION" ]; then
    # Extension told us exactly which session — use it directly
    true
elif [ -n "$TMUX_PANE_ID" ]; then
    TMUX_SESSION=$(ssh -o ConnectTimeout=10 -o BatchMode=yes \
        "$SSH_DEST" \
        "${shrc_source}cs-tmux-window attach-or-create \
            '$IID' '$TMUX_PANE_ID' '$WORKDIR'")
else
    # Try to grab an unattached session for this instance.
    # On reload, code-server recreates terminals — each host-bash
    # grabs one unattached session instead of creating a new one.
    TMUX_SESSION=$(ssh -o ConnectTimeout=10 -o BatchMode=yes \
        "$SSH_DEST" \
        "${shrc_source}cs-tmux-window grab '$IID' '$WORKDIR'")
fi

if [ $? -ne 0 ] || [ -z "$TMUX_SESSION" ]; then
    echo "Failed to create tmux session" >&2
    exit 1
fi

# On SIGHUP/SIGTERM, just exit. Do NOT kill the tmux session.
# We cannot reliably distinguish "user closed pane" from "container
# stopping" — SSH to host works briefly during container stop, so
# any SSH-based check is a race condition.
#
# tmux sessions are cleaned up by:
# - User typing 'exit' (shell exits → tmux auto-destroys session)
# - Extension's removePaneFromMapping (for tracked terminals)
# - Container eviction (cs-tmux-window cleanup in stopContainer)
# - Periodic orphan sweep (5-minute interval)
trap 'exit 0' HUP TERM

# Attach loop — reconnect to same session on SSH drop
MAX_RETRIES=60
RETRY_DELAY=2
retries=0

while true; do
    # ControlMaster=no: each interactive attach is long-lived, so it
    # gains nothing from multiplexing but would hold a session slot on
    # the shared master for its whole lifetime. On reattach every
    # terminal reconnects at once; multiplexed they exhaust sshd's
    # per-connection MaxSessions (default 10) -> "Session open refused
    # by peer". A dedicated connection per terminal has no such ceiling.
    # The shared master stays for the short control commands above.
    ssh -t \
        -o ControlMaster=no \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=3 \
        "$SSH_DEST" \
        "tmux attach-session -t '$TMUX_SESSION'"
    exit_code=$?

    case $exit_code in
        0)
            # Clean exit: user typed 'exit' or session destroyed
            break
            ;;
        255)
            # SSH connection error — reconnect
            retries=$((retries + 1))
            if [ $retries -ge $MAX_RETRIES ]; then
                echo "SSH reconnection failed after $retries attempts" >&2
                exit 1
            fi
            echo "[reconnecting... attempt $retries]" >&2
            sleep $RETRY_DELAY
            ;;
        *)
            # tmux error — check if session still exists
            if ssh -o ConnectTimeout=5 -o BatchMode=yes \
                "$SSH_DEST" \
                "tmux has-session -t '$TMUX_SESSION'" \
                2>/dev/null; then
                retries=$((retries + 1))
                [ $retries -ge $MAX_RETRIES ] && break
                sleep $RETRY_DELAY
            else
                # Session gone — terminal is done
                break
            fi
            ;;
    esac
done
