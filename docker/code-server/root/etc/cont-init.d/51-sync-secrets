#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# One-time secrets sync from host to container keyring
# Syncs VSCode extension secrets on first container start only

HOST_SECRETS_DIR="/host-secrets"
CONTAINER_KEYRING_DIR="/config/.local/share/keyrings"
SYNC_MARKER="$CONTAINER_KEYRING_DIR/.secrets-synced"

echo "[init-secrets] Checking for secrets sync..."

# Skip if already synced (marker file exists)
if [ -f "$SYNC_MARKER" ]; then
    echo "[init-secrets] Secrets already synced, skipping"
    exit 0
fi

# Check if host secrets exist
if [ ! -d "$HOST_SECRETS_DIR" ] || [ ! -f "$HOST_SECRETS_DIR/storage.json" ]; then
    echo "[init-secrets] No host secrets found, container will start fresh"
    touch "$SYNC_MARKER"
    chown abc:abc "$SYNC_MARKER"
    exit 0
fi

echo "[init-secrets] Syncing secrets from host to container keyring..."

# Wait for gnome-keyring daemon to be ready
for i in {1..10}; do
    if pgrep -x gnome-keyring-daemon > /dev/null; then
        break
    fi
    echo "[init-secrets] Waiting for gnome-keyring daemon... ($i/10)"
    sleep 1
done

# Verify gnome-keyring is running
if ! pgrep -x gnome-keyring-daemon > /dev/null; then
    echo "[init-secrets] ERROR: gnome-keyring daemon not running, skipping sync"
    touch "$SYNC_MARKER"
    chown abc:abc "$SYNC_MARKER"
    exit 0
fi

# Export secrets from host storage.json and import to container keyring
# This assumes VSCode basic password store format

# Get D-Bus session address from environment or use default
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    echo "[init-secrets] WARNING: DBUS_SESSION_BUS_ADDRESS not set, secret sync may fail"
fi

su - abc -c "
    # Inherit D-Bus session from parent environment
    export DBUS_SESSION_BUS_ADDRESS=\"\$DBUS_SESSION_BUS_ADDRESS\"
    
    # Parse storage.json and import secrets using secret-tool
    # GitHub authentication
    GITHUB_TOKEN=\$(jq -r '.\"github.auth\" // empty' '$HOST_SECRETS_DIR/storage.json')
    if [ -n \"\$GITHUB_TOKEN\" ] && [ \"\$GITHUB_TOKEN\" != \"null\" ]; then
        echo '[init-secrets] Importing GitHub credentials'
        echo \"\$GITHUB_TOKEN\" | secret-tool store --label='GitHub Token' service github account vscode 2>/dev/null || true
    fi
    
    # GitLab authentication
    GITLAB_TOKEN=\$(jq -r '.\"gitlab.auth\" // empty' '$HOST_SECRETS_DIR/storage.json')
    if [ -n \"\$GITLAB_TOKEN\" ] && [ \"\$GITLAB_TOKEN\" != \"null\" ]; then
        echo '[init-secrets] Importing GitLab credentials'
        echo \"\$GITLAB_TOKEN\" | secret-tool store --label='GitLab Token' service gitlab account vscode 2>/dev/null || true
    fi
    
    # Docker authentication
    DOCKER_TOKEN=\$(jq -r '.\"docker.auth\" // empty' '$HOST_SECRETS_DIR/storage.json')
    if [ -n \"\$DOCKER_TOKEN\" ] && [ \"\$DOCKER_TOKEN\" != \"null\" ]; then
        echo '[init-secrets] Importing Docker credentials'
        echo \"\$DOCKER_TOKEN\" | secret-tool store --label='Docker Token' service docker account vscode 2>/dev/null || true
    fi
    
    # Azure authentication
    AZURE_TOKEN=\$(jq -r '.\"azure.auth\" // empty' '$HOST_SECRETS_DIR/storage.json')
    if [ -n \"\$AZURE_TOKEN\" ] && [ \"\$AZURE_TOKEN\" != \"null\" ]; then
        echo '[init-secrets] Importing Azure credentials'
        echo \"\$AZURE_TOKEN\" | secret-tool store --label='Azure Token' service azure account vscode 2>/dev/null || true
    fi
    
    # Copilot authentication
    COPILOT_TOKEN=\$(jq -r '.\"github.copilot.auth\" // empty' '$HOST_SECRETS_DIR/storage.json')
    if [ -n \"\$COPILOT_TOKEN\" ] && [ \"\$COPILOT_TOKEN\" != \"null\" ]; then
        echo '[init-secrets] Importing Copilot credentials'
        echo \"\$COPILOT_TOKEN\" | secret-tool store --label='Copilot Token' service copilot account vscode 2>/dev/null || true
    fi
"

# Create marker file to prevent re-sync on restarts
touch "$SYNC_MARKER"
chown abc:abc "$SYNC_MARKER"

echo "[init-secrets] ✓ Secrets sync complete"