#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# One-time settings sync from host to container
# Syncs shared settings.json and keybindings.json on first container start only

HOST_SETTINGS_DIR="/host-settings"
CONTAINER_USER_DIR="/config/data/User"
SYNC_MARKER="$CONTAINER_USER_DIR/.settings-synced"

echo "[init-settings] Checking for settings sync..."

# Skip if already synced (marker file exists)
if [ -f "$SYNC_MARKER" ]; then
    echo "[init-settings] Settings already synced, skipping"
    exit 0
fi

# Create container User directory if it doesn't exist
mkdir -p "$CONTAINER_USER_DIR"
chown abc:abc "$CONTAINER_USER_DIR"

# Check if host settings exist
if [ ! -d "$HOST_SETTINGS_DIR" ]; then
    echo "[init-settings] No host settings directory found, container will start with defaults"
    touch "$SYNC_MARKER"
    chown abc:abc "$SYNC_MARKER"
    exit 0
fi

echo "[init-settings] Syncing settings from host to container..."

# Copy settings.json if it exists on host
if [ -f "$HOST_SETTINGS_DIR/settings.json" ]; then
    if [ ! -f "$CONTAINER_USER_DIR/settings.json" ]; then
        echo "[init-settings] Copying settings.json"
        cp "$HOST_SETTINGS_DIR/settings.json" "$CONTAINER_USER_DIR/settings.json"
        chmod 644 "$CONTAINER_USER_DIR/settings.json"
        chown abc:abc "$CONTAINER_USER_DIR/settings.json"
    else
        echo "[init-settings] settings.json already exists, skipping"
    fi
else
    echo "[init-settings] No settings.json found on host"
fi

# Copy keybindings.json if it exists on host
if [ -f "$HOST_SETTINGS_DIR/keybindings.json" ]; then
    if [ ! -f "$CONTAINER_USER_DIR/keybindings.json" ]; then
        echo "[init-settings] Copying keybindings.json"
        cp "$HOST_SETTINGS_DIR/keybindings.json" "$CONTAINER_USER_DIR/keybindings.json"
        chmod 644 "$CONTAINER_USER_DIR/keybindings.json"
        chown abc:abc "$CONTAINER_USER_DIR/keybindings.json"
    else
        echo "[init-settings] keybindings.json already exists, skipping"
    fi
else
    echo "[init-settings] No keybindings.json found on host"
fi

# Create marker file to prevent re-sync on restarts
touch "$SYNC_MARKER"
chown abc:abc "$SYNC_MARKER"

echo "[init-settings] ✓ Settings sync complete"