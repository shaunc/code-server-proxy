{
  "name": "code-server-proxy",
  "version": "1.0.0",
  "description": "Reverse proxy for workspace-isolated code-server instances",
  "main": "src/proxy.js",
  "scripts": {
    "start": "node src/proxy.js",
    "dev": "nodemon src/proxy.js",
    "test": "node --test --test-force-exit 'test/**/*.test.js'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "proxy",
    "code-server",
    "reverse-proxy",
    "workspace-isolation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dockerode": "^4.0.0",
    "http-proxy": "^1.18.1",
    "http-proxy-middleware": "^2.0.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "nodemon": "^3.0.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,sh}": [
      "prettier --write"
    ]
  }
}
