#!/usr/bin/env bash
# .githooks/pre-commit — dispatcher
# Calls pre-commit framework, then beads. Tracked in git.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"

# 1. pre-commit framework (generated shim in subdirectory)
if [ -x "$DIR/pre-commit-framework/pre-commit" ]; then
    "$DIR/pre-commit-framework/pre-commit" "$@" || exit $?
fi

# 2. beads
"$DIR/beads-pre-commit" "$@" || true
