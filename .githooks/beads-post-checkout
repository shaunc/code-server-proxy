#!/usr/bin/env bash
# .githooks/beads-post-checkout
#
# After a branch switch or worktree checkout, re-export the
# authoritative Dolt state to .beads/issues.jsonl. Fixes the case
# where the checked-out branch's JSONL is stale relative to Dolt
# (Dolt is shared across worktrees; JSONL is per-branch snapshot
# at different export times). See ffmeta-u8ja.
#
# Args: <prev-HEAD> <new-HEAD> <branch-checkout-flag>. Only act on
# branch checkouts (flag=1), not file checkouts (flag=0).
if [ "${3:-1}" = "1" ] && command -v bd >/dev/null 2>&1; then
    export BD_GIT_HOOK=1
    bd hooks run post-checkout "$@" || true
    if [ -f .beads/issues.jsonl ]; then
        bd export --quiet -o .beads/issues.jsonl 2>/dev/null || true
    fi
fi
