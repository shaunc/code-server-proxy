[Unit]
Description=Code-Server Workspace Instance - %i
After=network.target

[Service]
Type=simple
ExecStart=/home/shauncutts/src/other/code-server-proxy/scripts/launch-workspace-instance.sh %i
WorkingDirectory=/home/shauncutts/.code-workspaces/instances/%i
Restart=on-failure
RestartSec=10s
StandardOutput=append:/home/shauncutts/.code-workspaces/instances/%i/logs/stdout.log
StandardError=append:/home/shauncutts/.code-workspaces/instances/%i/logs/stderr.log
MemoryMax=4G
CPUQuota=300%

[Install]
WantedBy=default.target