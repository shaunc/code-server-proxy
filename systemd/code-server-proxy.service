[Unit]
Description=Code-Server Workspace Isolation Proxy
After=network.target ssh-agent.service
Requires=ssh-agent.service

[Service]
Type=simple
ExecStart=/home/shauncutts/.nvm/versions/node/v22.17.1/bin/node /home/shauncutts/src/other/code-server-proxy/src/proxy.js
WorkingDirectory=/home/shauncutts/src/other/code-server-proxy
Restart=on-failure
RestartSec=5s
Environment=NODE_ENV=production
Environment=XDG_RUNTIME_DIR=/run/user/1001
Environment=SSH_AUTH_SOCK=/run/user/1001/ssh-agent.socket
Environment=USE_DOCKER=true
Environment=ENABLE_AUTO_SSH=true
Environment=ENABLE_GPU=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target