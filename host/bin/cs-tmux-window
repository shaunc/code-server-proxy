#!/bin/bash
# cs-tmux-window — manage tmux sessions for code-server terminal panes
#
# Model: one tmux SESSION per terminal pane (not one session per workspace).
# Sessions are named cs-{instanceId}-{N} where N is auto-incremented.
# Each pane gets a fully independent tmux session with one window.
#
# Usage:
#   cs-tmux-window create <instance-id> [working-dir]
#     Create a new tmux session for a terminal pane.
#     Prints the full session name.
#
#   cs-tmux-window attach-or-create <instance-id> <pane-id> [working-dir]
#     Look up pane-id in the mapping file. If found and the session
#     still exists, print its name. Otherwise create a new session
#     and save the mapping.
#
#   cs-tmux-window list <instance-id>
#     List session names for an instance.
#
#   cs-tmux-window resolve <instance-id> <pane-id>
#     Print the tmux session name currently mapped to this pane-id.
#     Exit 0 if found, non-zero if not mapped.
#
#   cs-tmux-window cleanup <instance-id>
#     Kill all sessions for an instance.
#
# Environment:
#   CS_TMUX_CONF     — tmux config (default: ~/.config/code-server-proxy/tmux.conf)
#   CS_TMUX_MAPPINGS — mapping dir (default: ~/.config/code-server-proxy/mappings)

set -euo pipefail

# Raise soft fd limit so the tmux server (which inherits our limit
# on first session creation) can handle many sessions. The default
# systemd user session soft limit is 1024, which is ~340 sessions
# before fork/open failures. The hard limit is typically 524288.
ulimit -n 65536 2>/dev/null || true

TMUX_CONF="${CS_TMUX_CONF:-$HOME/.config/code-server-proxy/tmux.conf}"
MAPPING_DIR="${CS_TMUX_MAPPINGS:-$HOME/.config/code-server-proxy/mappings}"
LOCK_DIR="${MAPPING_DIR}/.locks"

TMUX_ARGS=()
[ -f "$TMUX_CONF" ] && TMUX_ARGS=(-f "$TMUX_CONF")

. ~/.shrc 2>/dev/null || true

# Find the next available session index for an instance.
next_index() {
    local prefix="cs-$1-"
    local max=-1
    while IFS= read -r name; do
        local n="${name#"$prefix"}"
        if [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -gt "$max" ]; then
            max="$n"
        fi
    done < <(tmux "${TMUX_ARGS[@]}" list-sessions -F '#{session_name}' 2>/dev/null \
        | grep "^${prefix}")
    echo $((max + 1))
}

# Create a new session for this instance, print its name.
# Retries on name collision (concurrent creation race).
create_session() {
    local iid="$1" workdir="${2:-.}"
    local attempts=0
    while [ $attempts -lt 20 ]; do
        local idx
        idx=$(next_index "$iid")
        local session="cs-${iid}-${idx}"
        if tmux "${TMUX_ARGS[@]}" new-session -d -s "$session" \
            -c "$workdir" 2>/dev/null; then
            echo "$session"
            return 0
        fi
        # Name collision — another process won the race, retry
        attempts=$((attempts + 1))
    done
    echo "create_session: failed after $attempts attempts" >&2
    return 1
}

# Read pane-id → session mapping.
read_mapping() {
    local map_file="$1" pane_id="$2"
    [ -f "$map_file" ] || return 1
    python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    v = d.get(sys.argv[2], '')
    if v:
        print(v)
        sys.exit(0)
    sys.exit(1)
except Exception:
    sys.exit(1)
" "$map_file" "$pane_id"
}

# Print the set of "owned" session names for an instance, one per line.
# A session is owned (a real, wanted session — a user terminal or a
# teammate tab) if it appears in EITHER source:
#   1. a value in the host pane→session mapping cs-<iid>.json (written by
#      attach-or-create and by the extension via `record`); or
#   2. a cs-tab sidecar ~/.cs-tab-names/<session> (teammate tabs, which
#      cs-tab creates directly via tmux new-session, bypassing this tool).
# Everything else that is a live cs-<iid>-* session is an unowned leak
# (bare-`grab` sessions from hidden env-discovery terminals, etc.).
owned_sessions() {
    local iid="$1"
    local map_file="$MAPPING_DIR/cs-${iid}.json"
    if [ -f "$map_file" ]; then
        python3 -c "
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    for v in d.values():
        if v:
            print(v)
except Exception:
    pass
" "$map_file"
    fi
    if [ -d "$HOME/.cs-tab-names" ]; then
        ls -1 "$HOME/.cs-tab-names" 2>/dev/null | grep "^cs-${iid}-" || true
    fi
}

# A pane command matching this is an idle login shell (safe to reap). A
# session with ANY pane running a non-shell command (claude/node/python/
# vim/…) is kept — the defense-in-depth guard, so even if ownership
# tracking has a gap a session doing real work is never killed. Used via
# `grep -vE` against a single prefetched `list-panes -a` snapshot (below)
# rather than one tmux call per session, which was slow enough on
# many-session instances to hit the caller's timeout.
IDLE_SHELL_RE='^(-?bash|-?sh|-?zsh|-?fish|-?dash|login|tmux)$'

# Write pane-id → session mapping (atomic).
write_mapping() {
    local map_file="$1" pane_id="$2" session="$3"
    mkdir -p "$(dirname "$map_file")"
    mkdir -p "$LOCK_DIR"
    (
        flock 9
        python3 -c "
import json, sys, os
map_file, pane_id, session = sys.argv[1], sys.argv[2], sys.argv[3]
tmp = map_file + '.tmp'
d = {}
if os.path.exists(map_file):
    try:
        d = json.load(open(map_file))
    except Exception:
        pass
d[pane_id] = session
with open(tmp, 'w') as f:
    json.dump(d, f)
os.rename(tmp, map_file)
" "$map_file" "$pane_id" "$session"
    ) 9>"$LOCK_DIR/$(basename "$map_file").lock"
}

case "${1:-}" in
    create)
        [ $# -lt 2 ] && { echo "Usage: cs-tmux-window create <instance-id> [workdir]" >&2; exit 1; }
        create_session "$2" "${3:-.}"
        ;;

    attach-or-create)
        [ $# -lt 3 ] && { echo "Usage: cs-tmux-window attach-or-create <instance-id> <pane-id> [workdir]" >&2; exit 1; }
        iid="$2"; pane_id="$3"; workdir="${4:-.}"
        map_file="$MAPPING_DIR/cs-${iid}.json"

        # Check if pane_id has a saved session mapping
        if saved_session=$(read_mapping "$map_file" "$pane_id"); then
            # Verify session still exists
            if tmux "${TMUX_ARGS[@]}" has-session -t "$saved_session" \
                2>/dev/null; then
                echo "$saved_session"
                exit 0
            fi
        fi

        # No mapping or session gone — create new
        session=$(create_session "$iid" "$workdir")
        write_mapping "$map_file" "$pane_id" "$session"
        echo "$session"
        ;;

    grab)
        # Grab an unattached session for this instance, or create new.
        # Used by host-bash on reload: each terminal grabs one session.
        # Uses flock + claim files to prevent two terminals grabbing
        # the same session (tmux doesn't show "attached" until the
        # actual tmux attach runs, which is after this returns).
        [ $# -lt 2 ] && { echo "Usage: cs-tmux-window grab <instance-id> [workdir]" >&2; exit 1; }
        iid="$2"; workdir="${3:-.}"
        claim_dir="$LOCK_DIR/claims-${iid}"
        mkdir -p "$claim_dir"
        (
            flock 9
            prefix="cs-${iid}-"
            # Find first unattached AND unclaimed session
            grabbed=""
            while IFS=' ' read -r name attached; do
                [ "$attached" != "0" ] && continue
                # Check claim file (skip if claimed within last 30s)
                claim_file="$claim_dir/$name"
                if [ -f "$claim_file" ]; then
                    claim_age=$(( $(date +%s) - $(stat -c %Y "$claim_file") ))
                    [ "$claim_age" -lt 30 ] && continue
                fi
                grabbed="$name"
                break
            done < <(tmux "${TMUX_ARGS[@]}" list-sessions \
                -F '#{session_name} #{session_attached}' 2>/dev/null \
                | grep "^${prefix}")

            if [ -n "$grabbed" ]; then
                touch "$claim_dir/$grabbed"
                echo "$grabbed"
            else
                # No unattached sessions — create new
                session=$(create_session "$iid" "$workdir")
                touch "$claim_dir/$session"
                echo "$session"
            fi
        ) 9>"$LOCK_DIR/grab-${iid}.lock"

        # Clean old claim files (>60s) in background
        find "$claim_dir" -maxdepth 1 -type f -mmin +1 -delete 2>/dev/null &
        ;;

    list)
        [ $# -lt 2 ] && { echo "Usage: cs-tmux-window list <instance-id>" >&2; exit 1; }
        tmux "${TMUX_ARGS[@]}" list-sessions -F '#{session_name}' 2>/dev/null \
            | grep "^cs-${2}-" || true
        ;;

    resolve)
        # Look up the session name mapped to a pane-id.
        # Used by the extension to find which session to kill on pane
        # close, since the extension's own mapping file does not know
        # the session name (host-bash chooses it via attach-or-create).
        [ $# -lt 3 ] && { echo "Usage: cs-tmux-window resolve <instance-id> <pane-id>" >&2; exit 1; }
        iid="$2"; pane_id="$3"
        map_file="$MAPPING_DIR/cs-${iid}.json"
        if session=$(read_mapping "$map_file" "$pane_id"); then
            # Verify the session actually exists before returning it
            if tmux "${TMUX_ARGS[@]}" has-session -t "$session" 2>/dev/null; then
                echo "$session"
                exit 0
            fi
        fi
        exit 1
        ;;

    cleanup)
        [ $# -lt 2 ] && { echo "Usage: cs-tmux-window cleanup <instance-id>" >&2; exit 1; }
        tmux "${TMUX_ARGS[@]}" list-sessions -F '#{session_name}' 2>/dev/null \
            | grep "^cs-${2}-" | while IFS= read -r s; do
                tmux "${TMUX_ARGS[@]}" kill-session -t "$s" 2>/dev/null || true
            done
        # Clean mapping file
        rm -f "$MAPPING_DIR/cs-${2}.json"
        ;;

    owned)
        # Print the owned session names for an instance (see owned_sessions).
        # Used by the extension to gate adoption and by the reaper.
        [ $# -lt 2 ] && { echo "Usage: cs-tmux-window owned <instance-id>" >&2; exit 1; }
        owned_sessions "$2" | sort -u
        ;;

    record)
        # Record a pane-id → session mapping the extension already knows
        # (reuse and adoption paths, where host-bash bypasses
        # attach-or-create). Makes those sessions owned.
        [ $# -lt 4 ] && { echo "Usage: cs-tmux-window record <instance-id> <pane-id> <session>" >&2; exit 1; }
        write_mapping "$MAPPING_DIR/cs-${2}.json" "$3" "$4"
        ;;

    reap)
        # Kill unowned, unattached, aged, idle-shell leak sessions for an
        # instance. Never touches attached, owned, or real-work sessions.
        #   cs-tmux-window reap <instance-id> [--dry-run] [--age-min N]
        # Prints one line per session considered: "KILL <s>" / "keep <s> <why>".
        shift
        [ $# -lt 1 ] && { echo "Usage: cs-tmux-window reap <instance-id> [--dry-run] [--age-min N]" >&2; exit 1; }
        iid="$1"; shift
        dry=0; age_min=5
        while [ $# -gt 0 ]; do
            case "$1" in
                --dry-run) dry=1; shift;;
                --age-min) age_min="$2"; shift 2;;
                *) echo "reap: unknown arg '$1'" >&2; exit 1;;
            esac
        done
        # The loop does its own explicit error handling (if-guards,
        # `|| echo`). Relax errexit/pipefail so a transient per-session
        # hiccup — a session vanishing between list-sessions and
        # list-panes during a reload, or a momentarily empty
        # session_created field — does not abort the whole reap.
        set +e +o pipefail
        now=$(date +%s)
        owned_tmp=$(mktemp)
        owned_sessions "$iid" | sort -u > "$owned_tmp"
        # Prefetch every pane's foreground command in ONE tmux call
        # (session_name -> pane_current_command lines). Per-session
        # tmux calls were slow enough on many-session instances to blow
        # the caller's timeout ("reap failed" every tick).
        panes_tmp=$(mktemp)
        tmux "${TMUX_ARGS[@]}" list-panes -a \
            -F '#{session_name} #{pane_current_command}' 2>/dev/null \
            > "$panes_tmp"
        while IFS=' ' read -r name attached created; do
            [ -z "$name" ] && continue
            # Guard against a malformed/racing list line (empty fields).
            [[ "$created" =~ ^[0-9]+$ ]] || { echo "keep $name no-age"; continue; }
            if [ "$attached" != "0" ]; then
                echo "keep $name attached"; continue
            fi
            if grep -qxF "$name" "$owned_tmp"; then
                echo "keep $name owned"; continue
            fi
            age=$(( now - created ))
            if [ "$age" -lt $(( age_min * 60 )) ]; then
                echo "keep $name too-young(${age}s)"; continue
            fi
            # Keep if any pane runs real work (non idle-shell command).
            nonidle=$(awk -v s="$name" '$1==s{print $2}' "$panes_tmp" \
                | grep -vE "$IDLE_SHELL_RE" | head -1)
            if [ -n "$nonidle" ]; then
                echo "keep $name running-work"; continue
            fi
            if [ "$dry" -eq 1 ]; then
                echo "KILL $name (dry-run)"
            else
                tmux "${TMUX_ARGS[@]}" kill-session -t "$name" 2>/dev/null \
                    && echo "KILL $name" || echo "keep $name kill-failed"
            fi
        done < <(tmux "${TMUX_ARGS[@]}" list-sessions \
            -F '#{session_name} #{session_attached} #{session_created}' \
            2>/dev/null | grep "^cs-${iid}-")
        rm -f "$owned_tmp" "$panes_tmp"
        ;;

    *)
        echo "Usage: cs-tmux-window {create|attach-or-create|grab|list|resolve|owned|record|reap|cleanup} ..." >&2
        exit 1
        ;;
esac
